# Configuração central da infraestrutura CitizenTech.
# Todos os scripts leem este arquivo. Mude aqui e rode "sudo ./provisionar.sh" de novo.

# Identidade do servidor
SERVIDOR_HOSTNAME="citizentech-srv"
SERVIDOR_DOMINIO="citizentech.local"
FUSO_HORARIO="America/Sao_Paulo"

# Rede host-only do VirtualBox (2ª placa da VM). O PC acessa a aplicação por este IP.
IP_ESTATICO="192.168.56.10"
PREFIXO_REDE="24"

# Servidores DNS usados pela VM (via systemd-resolved)
DNS_PRIMARIO="1.1.1.1"
DNS_SECUNDARIO="8.8.8.8"

# Aplicação web
APP_NOME="CitizenTech Assistente - Portal de Demonstracao"
APP_VERSAO="1.0.0"
APP_DIR="/var/www/citizentech"

# Monitoramento: limites (em %) que geram alerta
LIMITE_CPU="80"
LIMITE_MEMORIA="80"
LIMITE_DISCO="85"
INTERVALO_SEGUNDOS="15"

# Logs
LOG_DIR="/var/log/citizentech"
